# Database connection string for PostgreSQL
# In production (Railway), SSL is automatically enabled with self-signed cert support.
# Do NOT add ?sslmode= params - the server handles SSL configuration explicitly.
# The server automatically enables SSL (rejectUnauthorized=false) for non-local hosts.
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Session secret for Express session management
# Генеруйте випадковий рядок для продакшену (мінімум 32 символи)
SESSION_SECRET=your_random_session_secret_here_min_32_chars

# Client origin for CORS configuration
# Для Railway: https://your-app-name.up.railway.app
CLIENT_ORIGIN=http://localhost:5173

# WebSocket origin for real-time features
# Має співпадати з CLIENT_ORIGIN або бути окремим доменом для WebSocket з'єднань
SOCKET_ORIGIN=http://localhost:5173

# API key for map provider (Google Maps, Mapbox, тощо)
# Необхідний для функціоналу геолокації та карт
MAP_PROVIDER_KEY=your_map_provider_api_key_here

# API key for ImgBB image hosting
IMGBB_API_KEY=your_imgbb_api_key_here

# Optional: Reduce TensorFlow native logging (0=all, 1=warn, 2=error, 3=fatal)
TF_CPP_MIN_LOG_LEVEL=2

# Optional: Port for local development (Railway sets PORT automatically)
# PORT=5000
