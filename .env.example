# Database connection string for Neon/PostgreSQL
# In production (Railway/Neon), ensure SSL is required: add ?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# API key for ImgBB image hosting
IMGBB_API_KEY=your_imgbb_api_key_here

# Optional: Port for local development (Railway sets PORT automatically)
# PORT=5000
